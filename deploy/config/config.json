{
  "app": {
    "logLevel": "info",
    "port": 3300
  },
  "feishu": {
    "wsAutoReconnect": true,
    "wsLoggerLevel": "debug",
    "wsAgent": {
      "keepAliveMsecs": 90000,
      "maxSockets": 100,
      "maxFreeSockets": 1
    },
    "wsConnectWarnAfterMs": 30000,
    "wsReconnectWarnThreshold": 3,
    "reconnectReadyDebounceMs": 60000,
    "titleMaxLength": 120,
    "footerThreadNameMaxLength": 50,
    "sendRetry": {
      "maxAttempts": 5,
      "baseDelayMs": 1000,
      "multiplier": 2,
      "maxDelayMs": 10000
    }
  },
  "codex": {
    "bin": "codex",
    "profileMode": "isolated",
    "home": "$HOME/.codex-feishu-bridge",
    "sessionsDir": "$HOME/.codex-feishu-bridge/sessions",
    "backendMode": "app-server",
    "outputSoftLimit": 100000,
    "modelListMaxCount": 100,
    "appServer": {
      "sidebandCards": false,
      "inlineBlocks": "full"
    },
    "sandboxMode": "danger-full-access",
    "runTimeoutMs": 600000,
    "approvalTimeoutMs": 180000,
    "compactTimeoutMs": 180000,
    "spawn": {
      "statusIntervalMs": 60000
    }
  },
  "session": {
    "listMaxCount": 100,
    "resumeReplayCount": 5
  },
  "project": {
    "allowedRoots": [
      "$HOME"
    ],
    "defaultPath": "$HOME",
    "defaultSearchEnabled": true,
    "listMaxCount": 100
  },
  "commands": {
    "alias": {},
    "direct": [],
    "map": {}
  },
  "status": {
    "includeProject": true
  },
  "paths": {
    "storePath": "$HOME/.local/share/codex-feishu-bridge/bindings.json"
  }
}
